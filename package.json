{
  "name": "forge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run content && vite",
    "content": "tsx scripts/setup_pyodide.ts && tsx scripts/gen_reviews.ts && tsx scripts/build_content.ts",
    "build": "npm run content && vite build",
    "preview": "vite preview",
    "validate": "tsx scripts/validate_content.ts --phase L01,L02,L03,L04,L05,L06,L07",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "pytest": "python3 scripts/run_exercise_tests.py",
    "notebooks": "python3 scripts/run_notebooks.py",
    "check": "npm run validate && npm run typecheck && npm run lint && npm run test && npm run pytest && npm run build",
    "pyodide-test": "node scripts/run_pyodide_tests.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
