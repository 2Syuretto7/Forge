    "@testing-library/react": "16.3.0",
    "@types/d3-force": "3.0.10",
    "@types/d3-selection": "3.0.11",
    "@types/d3-zoom": "3.0.8",
    "@types/hast": "3.0.4",
    "@types/mdast": "4.0.4",
    "@types/node": "22.18.0",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
