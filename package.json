    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "idb": "8.0.4",
    "katex": "0.19.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
