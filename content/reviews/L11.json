 {
  "id": "L11/p3",
  "lesson": "L11",
  "kind": "prediction",
  "prompt": "<p>A kernel uses blocks of 256 threads and 128 registers per thread on a T4 SM (65536 registers, at most 32 warps). What is its occupancy?</p>",
  "answer": "b",
