 {
  "id": "L20/p4",
  "lesson": "L20",
  "kind": "prediction",
  "prompt": "<p>The fine-tuning set and the evaluation set were sampled from the same list of words, with replacement. Fine-tuned accuracy is 92%. What is the likely problem?</p>",
  "answer": "b",
  "answerKind": "choice",
  "tol": 0,
  "options": [
   {
    "key": "a",
    "html": "<p>None: sampling with replacement is the standard way to build both sets.</p>"
   },
   {
    "key": "b",
    "html": "<p>Some evaluation words were also trained on, so 92% mixes memory with generalization; the accuracy on words never trained on may be much lower.</p>"
   },
   {
    "key": "c",
    "html": "<p>The evaluation set is too large.</p>"
   },
   {
    "key": "d",
    "html": "<p>The model overfits, so the true accuracy is higher.</p>"
   }
  ],
  "explain": "<p>Any overlap between training and evaluation inflates the score on exactly the overlapping items (L12, L19). Split the word list once, before any training, and check the overlap explicitly (exercise 11). Report the clean accuracy.</p>"
 },
 {
  "id": "L20/concept1",
  "lesson": "L20",
  "kind": "concept",
  "prompt": "When does the Chinchilla ratio of about 20 tokens per parameter not apply?",
  "answer": "When data, not compute, is the limit: with a small corpus a larger model trained for many epochs with regularization and validation-based stopping does better.",
  "answerKind": "text"
 },
 {
  "id": "L20/concept2",
  "lesson": "L20",
  "kind": "concept",
  "prompt": "What does a design document contain?",
  "answer": "Each decision with the main alternative, the evidence for the choice (a measurement, a calculation or a reference), and the result that would change it.",
  "answerKind": "text"
 },
 {
  "id": "L20/concept3",
  "lesson": "L20",
  "kind": "concept",
  "prompt": "Why fix evaluation sets before training?",
  "answer": "So that no training stage can see them; any overlap inflates scores exactly where it occurs.",
  "answerKind": "text"
 },
 {
  "id": "L20/concept4",
  "lesson": "L20",
  "kind": "concept",
  "prompt": "What is train/serve skew?",
  "answer": "Any difference between how inputs are processed in training and in serving, such as a different tokenizer or text normalization, which silently degrades the served model.",
  "answerKind": "text"
 },
 {
  "id": "L20/concept5",
  "lesson": "L20",
  "kind": "concept",
  "prompt": "Why keep a manifest of digests?",
  "answer": "So every reported number can be traced to the exact data and configuration that produced it, and a stale input is detected.",
  "answerKind": "text"
 },
