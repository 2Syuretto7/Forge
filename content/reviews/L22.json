 {
  "id": "L22/concept1",
  "lesson": "L22",
  "kind": "concept",
  "prompt": "Why is decoding memory-bound?",
  "answer": "Each decode step reads every weight once but does only about two operations per weight per sequence, an arithmetic intensity far below the GPU's ridge point unless many sequences share the step.",
  "answerKind": "text"
 },
 {
  "id": "L22/concept2",
  "lesson": "L22",
  "kind": "concept",
  "prompt": "How large is the key-value cache per token?",
  "answer": "Two times the number of layers times the number of key-value heads times the head dimension times the bytes per number.",
  "answerKind": "text"
 },
 {
  "id": "L22/concept3",
  "lesson": "L22",
  "kind": "concept",
  "prompt": "What does continuous batching change?",
  "answer": "It schedules at every decode step, so finished sequences leave at once and waiting requests take their slots instead of waiting for the whole batch to finish.",
  "answerKind": "text"
 },
 {
  "id": "L22/concept4",
  "lesson": "L22",
  "kind": "concept",
  "prompt": "What does paged attention fix?",
  "answer": "It allocates each sequence's cache in fixed-size pages as it grows, so memory is not reserved for tokens never generated and shared prefixes can share pages.",
  "answerKind": "text"
 },
 {
  "id": "L22/concept5",
  "lesson": "L22",
  "kind": "concept",
  "prompt": "Why does weight-only quantization speed up decoding?",
  "answer": "Decode time is mostly spent reading weights, so storing them in 8 or 4 bits cuts the bytes per step almost proportionally, if a kernel dequantizes as it loads.",
  "answerKind": "text"
 },
 {
  "id": "L22/concept6",
  "lesson": "L22",
  "kind": "concept",
  "prompt": "Why does speculative decoding preserve the output distribution?",
  "answer": "Each draft token is accepted with probability min(1, p/q) and a rejection resamples from the normalized residual max(0, p - q), which together give exactly p.",
  "answerKind": "text"
 },
